<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('back-to-top');
      if (btn) {
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    });
  }
</script>

<button
  id="back-to-top"
  class="inline-flex items-center gap-1 rounded-lg bg-black/5 dark:bg-white/15 px-3 py-1.5 text-sm font-medium text-black dark:text-white hover:bg-black/10 dark:hover:bg-white/20 transition group"
>
  <i class="ph ph-arrow-up group-hover:-translate-y-1 transition-transform"></i>
  <div class="text-sm">Back to top</div>
</button>

