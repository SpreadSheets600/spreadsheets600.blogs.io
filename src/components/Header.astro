---
import Link from "@components/Link.astro";
import { SITE } from "@consts";

const { pathname } = Astro.url;

const isActive = (path: string) => {
  if (path === "/") {
    return pathname === "/";
  }
  return pathname.startsWith(path);
};

const navLinks = [
  { name: "Blog", path: "/blog" },
  { name: "Links", path: "/links" },
  { name: "Prompts", path: "/prompts" },
  { name: "Tags", path: "/tags" },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-black/30 backdrop-blur-xl py-0" transition:persist>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <Link href="/" underline={false} class="text-lg font-semibold tracking-wide">
        <span class="bg-gradient-to-r from-white via-white/80 to-white/60 bg-clip-text">
          {SITE.TITLE}
        </span>
      </Link>

      <div class="flex items-center gap-6">
        <!-- Desktop Menu -->
        <ul class="hidden gap-8 md:flex">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.path} class:list={["nav-link", { active: isActive(link.path) }]}>
                  {link.name}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="https://spreadsheets600.buzz"
              target="_blank"
              rel="noopener noreferrer"
              class="nav-link inline-flex items-center gap-1"
            >
              Portfolio
              <i class="ph ph-arrow-up-right text-xs"></i>
            </a>
          </li>
        </ul>

        <button
          id="magnifying-glass"
          aria-label="Search"
          class="flex items-center rounded-lg bg-white/5 px-3 py-1.5 text-sm font-medium text-white hover:bg-white/10 transition gap-1"
        >
          <i class="ph ph-magnifying-glass text-lg"></i>
          <span class="hidden sm:inline">&nbsp;Search</span>
        </button>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-white/70 hover:text-white hover:bg-white/10 transition" aria-label="Toggle Menu">
          <i id="menu-icon-list" class="ph ph-list text-xl"></i>
          <i id="menu-icon-x" class="ph ph-x text-xl hidden"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-white/10 bg-black/40 backdrop-blur-xl md:hidden">
    <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
      <ul class="grid gap-2">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.path} class:list={["mobile-nav-link", { active: isActive(link.path) }]}>
                {link.name}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="https://spreadsheets600.buzz"
            target="_blank"
            rel="noopener noreferrer"
            class="mobile-nav-link inline-flex items-center gap-1"
          >
            Portfolio
            <i class="ph ph-arrow-up-right text-xs"></i>
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  function updateActiveLink() {
    const currentPath = window.location.pathname;

    // Desktop nav links
    document.querySelectorAll(".nav-link").forEach((link) => {
      const href = link.getAttribute("href");
      if (!href) return;
      const isActive = href === "/"
        ? currentPath === "/"
        : currentPath.startsWith(href);
      link.classList.toggle("active", isActive);
    });

    // Mobile nav links
    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      const href = link.getAttribute("href");
      if (!href) return;
      const isActive = href === "/"
        ? currentPath === "/"
        : currentPath.startsWith(href);
      link.classList.toggle("active", isActive);
    });
  }

  // Set active state on initial load
  updateActiveLink();

  // Update active state after each view transition
  document.addEventListener("astro:after-swap", updateActiveLink);

  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIconList = document.getElementById("menu-icon-list");
  const menuIconX = document.getElementById("menu-icon-x");

  if (mobileMenuBtn && mobileMenu && menuIconList && menuIconX) {
    mobileMenuBtn.addEventListener("click", () => {
      const isExpanded = !mobileMenu.classList.contains("hidden");

      if (isExpanded) {
        mobileMenu.classList.add("hidden");
        menuIconList.classList.remove("hidden");
        menuIconX.classList.add("hidden");
      } else {
        mobileMenu.classList.remove("hidden");
        menuIconList.classList.add("hidden");
        menuIconX.classList.remove("hidden");
      }
    });

    // Close menu when clicking a link
    const mobileLinks = mobileMenu.querySelectorAll("a");
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        menuIconList.classList.remove("hidden");
        menuIconX.classList.add("hidden");
      });
    });
  }
</script>

<style>
  @reference "tailwindcss";

  .nav-link {
    @apply text-sm font-semibold text-white/70 hover:text-white transition-all duration-200 relative;
  }

  .nav-link.active {
    @apply text-white;
  }

  .nav-link.active::after {
    content: "";
    @apply absolute -bottom-4 left-0 right-0 h-0.5 bg-gradient-to-r from-white/60 to-white/30 rounded-full;
  }

  .mobile-nav-link {
    @apply block rounded-md px-3 py-2 text-sm font-semibold text-white/70 hover:text-white hover:bg-white/10 transition-all duration-200;
  }

  .mobile-nav-link.active {
    @apply text-white bg-white/10;
  }
</style>
