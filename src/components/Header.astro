---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap justify-between gap-y-2">
      <Link href="/" underline={false}>
        <div class="font-semibold flex items-center gap-1">
          {SITE.TITLE} <i class="ph ph-flask text-xl"></i>
        </div>
      </Link>
      <nav class="flex items-center gap-1 text-sm">
        <Link href="/blog">blog</Link>
        <span>
          {`/`}
        </span>
        <Link href="/links">links</Link>
        <span>
          {`/`}
        </span>
        <Link href="/prompts">prompts</Link>
        <span>
          {`/`}
        </span>
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="flex items-center rounded-lg bg-black/5 dark:bg-white/15 px-3 py-1.5 text-sm font-medium text-black dark:text-white hover:bg-black/10 dark:hover:bg-white/20 transition gap-1"
        >
          <i class="ph ph-magnifying-glass text-lg"></i>
          &nbsp;Search
        </button>
      </nav>
    </div>
  </Container>
</header>

