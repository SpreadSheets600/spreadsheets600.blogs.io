---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"links"> | CollectionEntry<"prompts">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"links"> | CollectionEntry<"prompts">;
};

const href = entry.collection === 'links' && entry.data.url ? entry.data.url : `/${entry.collection}/${entry.id}`;
---

<a
  href={href}
  target={entry.collection === 'links' ? "_blank" : "_self"}
  rel={entry.collection === 'links' ? "noopener noreferrer" : ""}
  class="group card-shell flex flex-nowrap items-center px-4 py-4 pr-10 hover:-translate-y-1 hover:bg-black/50 relative"
>
  <div class="flex flex-1 flex-col truncate">
    <div class="font-semibold text-base sm:text-lg text-black dark:text-white">
      {entry.data.title}
    </div>
    <div class="text-xs sm:text-sm text-black/75 dark:text-white/75 truncate">
      {entry.data.description}
    </div>
  </div>
  <i class="ph ph-arrow-right absolute right-4 top-1/2 -translate-y-1/2 -translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300 text-xl text-black dark:text-white"></i>
</a>

