---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"links">
    | CollectionEntry<"prompts">;
};

const { entry } = Astro.props as {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"links">
    | CollectionEntry<"prompts">;
};

const href =
  entry.collection === "links" && entry.data.url
    ? entry.data.url
    : `/${entry.collection}/${entry.id}`;

function stripMarkdown(md: string): string {
  return md
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/\*\*(.+?)\*\*/g, "$1")
    .replace(/\*(.+?)\*/g, "$1")
    .replace(/`{1,3}[^`\n]*`{1,3}/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
    .replace(/>\s*/g, "")
    .replace(/^[-*+]\s+/gm, "")
    .replace(/\n{2,}/g, " ")
    .trim();
}

function truncateText(text: string, maxLength: number = 150): string {
  if (text.length <= maxLength) return text;
  return text.slice(0, maxLength).replace(/\s+\S*$/, "") + "...";
}

const isPrompt = entry.collection === "prompts";
const isBlog = entry.collection === "blog";
const isLink = entry.collection === "links";
---

{
  isPrompt ? (
    <div class="group card-shell relative px-4 py-4 hover:-translate-y-1 hover:bg-black/50">
      <div class="flex flex-col gap-2">
        <div class="text-base font-semibold text-black sm:text-lg dark:text-white">
          {entry.data.title}
        </div>
        <div class="relative group/code">
          <pre
            class="overflow-x-auto rounded-lg bg-black/10 p-3 text-xs leading-relaxed dark:bg-white/10"
          ><code>{entry.body}</code></pre>
          <button
            class="copy-btn absolute top-2 right-2 flex h-7 w-7 items-center justify-center rounded-md bg-black/20 text-white opacity-0 transition-opacity duration-200 hover:bg-black/40 group-hover/code:opacity-100"
            data-copy={entry.body}
            aria-label="Copy prompt"
          >
            <i class="ph ph-copy text-sm"></i>
          </button>
        </div>
      </div>
    </div>
  ) : (
    <a
      href={href}
      target={isLink ? "_blank" : "_self"}
      rel={isLink ? "noopener noreferrer" : ""}
      class="group card-shell relative flex flex-nowrap items-center px-4 py-4 pr-10 hover:-translate-y-1 hover:bg-black/50"
    >
      <div class="flex flex-1 flex-col min-w-0">
        <div class="text-base font-semibold text-black sm:text-lg dark:text-white">
          {entry.data.title}
        </div>
        <div class="text-xs text-black/75 sm:text-sm dark:text-white/75">
          {isBlog && entry.body
            ? truncateText(stripMarkdown(entry.body))
            : entry.data.description}
        </div>
      </div>
      <i
        class="ph ph-arrow-right absolute top-1/2 right-4 -translate-x-2 -translate-y-1/2 text-xl text-black opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 dark:text-white"
      ></i>
    </a>
  )
}

<script>
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      e.preventDefault();
      const text = btn.getAttribute("data-copy");
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const icon = btn.querySelector("i");
        if (icon) {
          icon.className = "ph ph-check text-sm";
          setTimeout(() => {
            icon.className = "ph ph-copy text-sm";
          }, 2000);
        }
      } catch {
        // clipboard not available
      }
    });
  });
</script>
