---
import type { CollectionEntry } from "astro:content";
import { stripMarkdown, truncateText } from "@lib/utils";

type Props = {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"links">
    | CollectionEntry<"prompts">;
};

const { entry } = Astro.props as {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"links">
    | CollectionEntry<"prompts">;
};

const href =
  entry.collection === "links" && entry.data.url
    ? entry.data.url
    : `/${entry.collection}/${entry.id}`;

const isLink = entry.collection === "links";
---

<a
  href={href}
  target={isLink ? "_blank" : "_self"}
  rel={isLink ? "noopener noreferrer" : ""}
  class="group card-shell relative flex flex-nowrap items-center px-4 py-4 pr-10 hover:-translate-y-1 hover:bg-black/50"
>
  <div class="flex flex-1 flex-col min-w-0">
    <div class="text-base font-semibold text-black sm:text-lg dark:text-white">
      {entry.data.title}
    </div>
    <div class="text-xs text-black/75 sm:text-sm dark:text-white/75">
      {entry.data.description || (entry.body ? truncateText(stripMarkdown(entry.body)) : "")}
    </div>
  </div>
  <i
    class="ph ph-arrow-right absolute top-1/2 right-4 -translate-x-2 -translate-y-1/2 text-xl text-black opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 dark:text-white"
  ></i>
</a>

