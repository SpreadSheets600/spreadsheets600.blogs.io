---
const year = new Date().getFullYear();

const ownerName = "SpreadSheets600";
const fallbackRepo = "spreadsheets600/spreadsheets600.blogs.io";

import BackToTop from "./BackToTop.astro";
---

<footer class="w-full">
  <div class="mx-auto max-w-7xl px-4 pt-6 pb-10">
    <div class="right-0 mb-2"><BackToTop /></div>
    <div
      class="card-shell flex items-center justify-between gap-4 rounded-2xl px-5 py-4 text-white shadow-[0_14px_40px_rgba(7,7,14,0.55)]"
    >
      <div
        class="flex flex-wrap items-center gap-3 text-xs font-medium text-white/85"
      >
        <span class="flex items-center gap-2">
          <i class="ph-light ph-copyright text-sm"></i>
          <span>{year} {ownerName}</span>
        </span>
      </div>

      <div
        class="flex flex-wrap items-center gap-4 text-[11px] font-medium text-white/70"
      >
        <span class="flex items-center gap-2">
          <i class="ph-light ph-clock text-sm text-white/80"></i>
          <span id="localTime">--:--</span>
        </span>
        <span class="hidden h-1 w-1 rounded-full bg-white/40 sm:inline-block"
        ></span>
        <span class="hidden items-center gap-2 sm:flex">
          <i class="ph-light ph-git-commit text-sm text-white/80"></i>
          <a
            id="latestCommitLink"
            class="hover:text-white"
            href={`https://github.com/${fallbackRepo}/commits`}
            target="_blank"
            rel="noreferrer"
          >
            <span id="latestCommitSha">GitHub</span>
          </a>
        </span>
      </div>
    </div>
  </div>
</footer>

<script>
  const API = "https://spreadsheets600-api-io.spreadsheets600.workers.dev";
  const timeEl = document.getElementById("localTime");
  const shaEl = document.getElementById("latestCommitSha");
  const linkEl = document.getElementById("latestCommitLink");

  const tick = () => {
    if (timeEl) timeEl.textContent = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
  };

  const ago = (iso: string) => {
    const minutes = Math.max(1, Math.round((Date.now() - Date.parse(iso)) / 60000));
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.round(minutes / 60);
    if (hours < 24) return `${hours}h ago`;
    return `${Math.round(hours / 24)}d ago`;
  };

  const loadPush = async () => {
    if (!shaEl || !linkEl) return;
    try {
      const response = await fetch(`${API}/snapshot`);
      const pushed = (await response.json())?.github?.data?.lastPushed;
      if (!pushed) return;
      shaEl.textContent = `${String(pushed.name).split("/").pop()} · ${ago(pushed.pushedAt)}`;
      linkEl.setAttribute("href", `https://github.com/${pushed.name}`);
    } catch {
      shaEl.textContent = "GitHub";
    }
  };

  const start = () => {
    tick();
    void loadPush();
  };

  start();
  setInterval(tick, 30000);
  document.addEventListener("astro:after-swap", start);
</script>
