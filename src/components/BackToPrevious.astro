---
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center gap-1 rounded-lg bg-black/5 dark:bg-white/15 px-3 py-1.5 text-sm font-medium text-black dark:text-white hover:bg-black/10 dark:hover:bg-white/20 transition group"
>
  <i class="ph ph-arrow-left group-hover:-translate-x-1 transition-transform"></i>
  <div class="text-sm">
    <slot />
  </div>
</a>

