---
---

<div class="background-container" transition:persist>
  <div class="background-image" id="bg-image"></div>
  <div class="background-overlay"></div>
</div>

<script>
  const API = "https://spreadsheets600-api-io.spreadsheets600.workers.dev";
  const KEY = "s600:wallpaper:v2";
  const MAX_AGE = 24 * 60 * 60 * 1000;

  const stored = (): string | null => {
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) ?? "null");
      return saved && typeof saved.url === "string" && Date.now() - saved.at < MAX_AGE ? saved.url : null;
    } catch {
      return null;
    }
  };

  const remember = (url: string) => {
    try {
      localStorage.setItem(KEY, JSON.stringify({ url, at: Date.now() }));
    } catch {}
  };

  const show = (url: string) => {
    const layer = document.getElementById("bg-image");
    if (!layer) return;
    const image = new Image();
    image.decoding = "async";
    image.onload = () => {
      layer.style.backgroundImage = `url('${url}')`;
      requestAnimationFrame(() => layer.classList.add("is-on"));
    };
    image.src = url;
  };

  const load = async () => {
    let url = stored();
    if (!url) {
      try {
        const response = await fetch(`${API}/header?format=json`);
        url = response.ok ? ((await response.json()) as { url?: string }).url ?? null : null;
      } catch {
        url = null;
      }
      if (url) remember(url);
    }
    if (url) show(url);
  };

  const start = () => {
    const layer = document.getElementById("bg-image");
    if (layer && !layer.classList.contains("is-on")) void load();
  };

  start();
  document.addEventListener("astro:after-swap", start);
</script>

<style>
  .background-container {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: #0a0a0a;
  }

  .background-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .background-image:global(.is-on) {
    opacity: 1;
  }

  .background-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 60% at 50% 10%, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.08)),
      rgba(0, 0, 0, 0.8);
  }
</style>
