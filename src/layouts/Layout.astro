---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import Background from "@components/Background.astro";
import { SITE } from "@consts";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@phosphor-icons/web/regular/style.css";
import "@phosphor-icons/web/light/style.css";
import "@phosphor-icons/web/fill/style.css";

type Props = {
  title: string;
  description: string;
  image?: string;
};

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <Head title={`${title} | ${SITE.TITLE}`} description={description} image={image} />
  </head>
  <body class="relative flex min-h-screen flex-col font-sans antialiased">
    <noscript>
      <style>
        .animate {
          opacity: 1;
          translate: var(--tw-translate-x) calc(var(--spacing) * 0);
        }
      </style>
    </noscript>
    <Background />
    <div class="app-container flex min-h-screen w-full flex-col">
      <Header />
      <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
        <slot />
      </main>
      <Footer />
    </div>
    <Pagefind />
    <script>
      const glow = (event: PointerEvent) => {
        const card = (event.target as HTMLElement | null)?.closest<HTMLElement>(".card-shell, .card-shell-lg");
        if (!card) return;
        const box = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${event.clientX - box.left}px`);
        card.style.setProperty("--my", `${event.clientY - box.top}px`);
      };
      document.addEventListener("pointermove", glow, { passive: true });
    </script>
  </body>
</html>
