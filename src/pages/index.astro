---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import SocialLinks from "@components/SocialLinks.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const links: CollectionEntry<"links">[] = (
  await getCollection("links")
)
  .filter((link) => !link.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const prompts: CollectionEntry<"prompts">[] = (
  await getCollection("prompts")
)
  .filter((prompt) => !prompt.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16" data-pagefind-ignore>
      <section class="animate">
        <div id="about" class="card-shell-lg card-pad">
          <header class="mb-4 sm:mb-5">
            <h1 class="text-2xl font-bold text-white sm:text-3xl flex items-center gap-2">
              {SITE.TITLE} <i class="ph ph-flask text-2xl"></i>
            </h1>
          </header>

          <section class="space-y-4 text-base leading-relaxed text-white/80 sm:text-lg">
            <article class="space-y-4">
              <p>
                Welcome to my blog &mdash; a place where I write about whatever&rsquo;s on my mind. <strong class="text-white">Linux</strong>, <strong class="text-white">coding</strong>, <strong class="text-white">gaming</strong>, <strong class="text-white">anime</strong>, personal stories &mdash; if it interests me, it&rsquo;ll end up here.
              </p>
              <p>
                This is my dedicated blog site. If you&rsquo;re looking for my portfolio, head over to <Link href="https://spreadsheets600.buzz" external>spreadsheets600.buzz</Link>.
              </p>
              <p>
                I use this space for <Link href="/blog">blog posts</Link>, sharing useful <Link href="/links">links</Link>, and saving <Link href="/prompts">prompts</Link>.
              </p>
            </article>
          </section>
        </div>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-y-2">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
              <i class="ph-light ph-newspaper text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-white">Latest Posts</h2>
          </div>
          <Link href="/blog"> See all posts </Link>
        </div>
        <ul class="not-prose flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-y-2">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
              <i class="ph-light ph-link text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-white">Recent Links</h2>
          </div>
          <Link href="/links"> See all links </Link>
        </div>
        <ul class="not-prose flex flex-col gap-4">
          {
            links.map((link) => (
              <li>
                <ArrowCard entry={link} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-y-2">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
              <i class="ph-light ph-terminal-window text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-white">Recent Prompts</h2>
          </div>
          <Link href="/prompts"> See all prompts </Link>
        </div>
        <ul class="not-prose flex flex-col gap-4">
          {
            prompts.map((prompt) => (
              <li>
                <ArrowCard entry={prompt} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate">
        <SocialLinks />
      </section>
    </div>
  </Container>
</Layout>
